################
#### HELPER ####
################
@import 'EXT:corporate_template/Configuration/TypoScript/Main/Helper/DynamicContent.typoscript'


##############
#### PAGE ####
##############
page = PAGE
page {
    typeNum = 0
    shortcutIcon = EXT:corporate_template/Resources/Public/Icons/favicon.ico

    10 = FLUIDTEMPLATE
    10 {
        # The template name is derived from the backend layout of the page:
        # pagets__home -> Home.html, pagets__normal -> Normal.html, none -> Default.html
        templateName = TEXT
        templateName {
            cObject = TEXT
            cObject {
                data = pagelayout
                required = 1
                case = uppercamelcase
                split {
                    token = pagets__
                    cObjNum = 1
                    1.current = 1
                }
            }
            ifEmpty = Default
        }
        templateRootPaths {
            0 = EXT:corporate_template/Resources/Private/Templates/Page/
            1 = {$page.fluidtemplate.templateRootPath}
        }
        partialRootPaths {
            0 = EXT:corporate_template/Resources/Private/Partials/Page/
            1 = {$page.fluidtemplate.partialRootPath}
        }
        layoutRootPaths {
            0 = EXT:corporate_template/Resources/Private/Layouts/Page/
            1 = {$page.fluidtemplate.layoutRootPath}
        }
        settings {
            homePageUid = {$plugin.tx_corporatetemplate.settings.homePageUid}
        }
        dataProcessing {
            10 = files
            10 {
                references.fieldName = media
                references.table = pages
            }
            20 = menu
            20 {
                levels = 2
                includeSpacer = 1
                as = mainnavigation
            }
            # Replaces the old HMENU "special = language" (lib.languageMenu).
            # Languages and their labels (EN, DE, ...) come from the site configuration.
            30 = language-menu
            30 {
                languages = auto
                as = languageNavigation
            }
        }
    }

    meta {
        viewport = {$page.meta.viewport}
        robots = {$page.meta.robots}
        apple-mobile-web-app-capable = {$page.meta.apple-mobile-web-app-capable}
        description = {$page.meta.description}
        description {
            override.field = description
        }
        author = {$page.meta.author}
        author {
            override.field = author
        }
        keywords = {$page.meta.keywords}
        keywords {
            override.field = keywords
        }
    }

    includeCSS {
        corporate_template_layout = EXT:corporate_template/Resources/Public/Css/layout.css
        isotope = EXT:corporate_template/Resources/Public/Css/isotope.css
    }

    includeJSFooterlibs {
        jquery = https://ajax.googleapis.com/ajax/libs/jquery/1.11.3/jquery.min.js
        jquery.external = 1
    }

    includeJSFooter {
        corporate_template_scripts = EXT:corporate_template/Resources/Public/JavaScript/Src/main.js
        superslides = EXT:corporate_template/Resources/Public/JavaScript/jquery.superslides.min.js
        isotope = EXT:corporate_template/Resources/Public/JavaScript/jquery.isotope.min.js
        nav = EXT:corporate_template/Resources/Public/JavaScript/jquery.nav.js
        magnific-popup = EXT:corporate_template/Resources/Public/JavaScript/jquery.magnific-popup.js
        hoverdir = EXT:corporate_template/Resources/Public/JavaScript/jquery.hoverdir.js
        portfolio = EXT:corporate_template/Resources/Public/JavaScript/portfolio.js
    }
}


################
#### CONFIG ####
################
# Language specific settings (sys_language_uid, locale, html lang attribute,
# linkVars L, ...) are configured in the site configuration since TYPO3 v9.5
# and must not be set in TypoScript anymore.
config {
    no_cache = {$config.no_cache}
    pageTitleFirst = 1
    doctype = html5
    admPanel = {$config.admPanel}
    debug = 0
    cache_period = 86400
    sendCacheHeaders = {$config.sendCacheHeaders}
    disablePrefixComment = 1
    headerComment = {$config.headerComment}
    htmlTag.attributes.class = no-js
    contentObjectExceptionHandler = 0
    noScaleUp = 1
    compressJs = 0
    compressCss = 0
    concatenateJs = 0
    concatenateCss = 0
}
