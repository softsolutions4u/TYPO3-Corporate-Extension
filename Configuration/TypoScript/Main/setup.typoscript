################################################
#### CONTENT ELEMENTS (corporatetemplate_*) ####
################################################
# Shared rendering definition. The elements render without the
# fluid_styled_content frame on purpose: the CSS/JS of the template
# expects exactly this markup.
lib.corporateTemplateContentElement = FLUIDTEMPLATE
lib.corporateTemplateContentElement {
    templateRootPaths {
        0 = EXT:corporate_template/Resources/Private/Templates/Content/
        10 = {$plugin.tx_corporatetemplate.view.templateRootPath}
    }
    partialRootPaths {
        0 = EXT:corporate_template/Resources/Private/Partials/
        10 = {$plugin.tx_corporatetemplate.view.partialRootPath}
    }
    layoutRootPaths {
        0 = EXT:corporate_template/Resources/Private/Layouts/
        10 = {$plugin.tx_corporatetemplate.view.layoutRootPath}
    }
    settings {
        homePageUid = {$plugin.tx_corporatetemplate.settings.homePageUid}
    }
}

# Inline child records of the template are stored with "parentid" (uid of the
# parent record) and "parenttable". Hidden/deleted/time restricted records and
# translations are handled by the DatabaseQueryProcessor automatically.

tt_content.corporatetemplate_bannerslider =< lib.corporateTemplateContentElement
tt_content.corporatetemplate_bannerslider {
    templateName = Bannerslider
    dataProcessing {
        10 = database-query
        10 {
            if.isTrue.field = tx_corporatetemplate_bannertitlesbox
            table = tx_corporatetemplate_bannertitlesbox
            pidInList.field = pid
            where = {#parentid}=###uid###
            orderBy = sorting
            markers.uid.field = uid
            as = data_tx_corporatetemplate_bannertitlesbox
        }
        20 = database-query
        20 {
            if.isTrue.field = tx_corporatetemplate_bannerimagesbox
            table = tx_corporatetemplate_bannerimagesbox
            pidInList.field = pid
            where = {#parentid}=###uid###
            orderBy = sorting
            markers.uid.field = uid
            as = data_tx_corporatetemplate_bannerimagesbox
            dataProcessing {
                10 = files
                10 {
                    references.fieldName = tx_corporatetemplate_bannerimage
                    references.table = tx_corporatetemplate_bannerimagesbox
                    as = data_tx_corporatetemplate_bannerimage
                }
            }
        }
    }
}

