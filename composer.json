{
    "name": "corporate_template/corporate_template",
    "type": "typo3-cms-extension",
    "description": "Corporate - One page responsive business template for TYPO3 13 LTS and 14 LTS",
    "homepage": "https://www.softsolutions4u.com/",
    "license": [
        "GPL-2.0-or-later"
    ],
    "keywords": [
        "TYPO3",
        "distribution",
        "template",
        "frontend",
        "corporate"
    ],
    "authors": [
        {
            "name": "Soft Solutions4U",
            "email": "sharmistha@softsolutions4u.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3",
        "typo3/cms-fluid": "^13.4 || ^14.3",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.3",
        "typo3/cms-rte-ckeditor": "^13.4 || ^14.3"
    },
    "suggest": {
        "in2code/powermail": "Contact form of the demo site (TYPO3 13: ^13.3)",
        "clickstorm/go-maps-ext": "Google map of the demo site (^8.1)",
        "clickstorm/cs-seo": "SEO fields (TYPO3 13: ^9, TYPO3 14: ^10)"
    },
    "autoload": {
        "psr-4": {
            "CorporateTemplate\\CorporateTemplate\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "corporate_template",
            "version": "3.0.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
